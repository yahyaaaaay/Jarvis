# Copy this file to .env and fill in your own key.
# Never commit the real .env file — it's already excluded in .gitignore.

# Free API key from https://console.groq.com/keys — no credit card needed.
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the model (default is openai/gpt-oss-20b, fast + free-tier + tool calling).
# GROQ_MODEL=openai/gpt-oss-20b

PORT=3000
